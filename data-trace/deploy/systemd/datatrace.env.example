# DataTrace 环境变量示例（systemd 裸机部署）
# 复制为 /etc/datatrace.env 并填写真实值：
#   sudo cp datatrace.env.example /etc/datatrace.env
#   sudo chmod 600 /etc/datatrace.env
#   sudo chown root:root /etc/datatrace.env

PORT=3000
PUBLIC_BASE_URL=https://your-domain.example.com
MANAGE_LINK_SECRET=replace-with-a-long-random-secret
DISPATCH_API_KEY=replace-with-a-long-random-secret
MAIL_LOG_API_KEY=replace-with-a-long-random-secret

# —— 邮件发送（已实现；Resend/Postmark 风格 HTTP API，可适配 SES / 阿里云 DirectMail）——
MAIL_API_URL=https://api.resend.com/emails
MAIL_API_KEY=replace-with-a-long-random-secret
MAIL_FROM=DataTrace <no-reply@your-domain.example>
MAIL_FROM_NAME=DataTrace
# =1 时订阅接口直接返回确认链接（联调用，生产置 0）
CONFIRMATION_DRY_RUN=0
MAX_SEND_ATTEMPTS=3
# 部署在可信反向代理之后时置 1（限流取 x-forwarded-for）
TRUST_PROXY=0

# —— 数据目录（可选）——
# 应用已支持 DATABASE_PATH 直接指定 SQLite 文件位置；
# 亦可保持默认 /opt/datatrace/data/data-trace.sqlite 并把 data 目录符号链接到 /var/lib/datatrace（见 deploy/README.md 2.2 节）。
# DATABASE_PATH=/var/lib/datatrace/data-trace.sqlite
