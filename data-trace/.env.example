PORT=3000
PUBLIC_BASE_URL=https://your-public-miaoda-url.aiforce.cloud
MANAGE_LINK_SECRET=replace-with-a-long-random-secret
DISPATCH_API_KEY=replace-with-a-long-random-secret
MAIL_LOG_API_KEY=replace-with-a-long-random-secret

# 邮件发送（Resend/Postmark 风格 HTTP API；可替换为 SES / 阿里云 DirectMail 适配层）
# 邮件服务商的发信接口地址
MAIL_API_URL=https://api.resend.com/emails
# 邮件服务商的 API Key（Authorization: Bearer <MAIL_API_KEY>）
MAIL_API_KEY=replace-with-a-long-random-secret
# 发件人地址，支持 "名称 <email>" 形式
MAIL_FROM=DataTrace <no-reply@your-domain.example>
# 发件人显示名称（备用）
MAIL_FROM_NAME=DataTrace
# 设为 1 时：订阅时不真实发送确认邮件，改为在订阅响应顶层返回 confirmationUrl（便于本地/测试）
CONFIRMATION_DRY_RUN=0

# ── 发信通道：SMTP（Gmail 等），设置 MAIL_TRANSPORT=smtp 后优先于 HTTP 通道 ──
# Gmail 要求：账号开启两步验证后，在 Google 账号安全页生成「应用专用密码」（16 位）
# 填入 MAIL_SMTP_PASS；MAIL_FROM 需与该 Gmail 地址一致（信封发件人由 Gmail 强制）。
# MAIL_TRANSPORT=smtp
# MAIL_SMTP_HOST=smtp.gmail.com
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USER=your-account@gmail.com
# MAIL_SMTP_PASS=xxxxxxxxxxxxxxxx
# MAIL_FROM=DataTrace <your-account@gmail.com>
# 仅本地测试可置 0 关闭 STARTTLS；生产必须保持 1
# MAIL_SMTP_SECURE=1

# 单条 dispatch 消息最大发送重试次数
MAX_SEND_ATTEMPTS=3
# 设为 1 时：限流取 x-forwarded-for 首个地址作为客户端 IP（仅当部署在可信代理之后）
TRUST_PROXY=0
